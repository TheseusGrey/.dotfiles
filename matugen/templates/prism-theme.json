{
	"name": "matugen",
	"author": "matugen",
	"widgets": "fusion",
	"qssFilePath": "themeStyle.css",
	"colors": {
		"Window": "{{ colors.surface.default.hex | set_lightness: 11 }}",
		"WindowText": "{{ colors.on_surface.default.hex | set_lightness: 93 }}",
		"Base": "{{ colors.surface_container_low.default.hex | set_lightness: 12 }}",
		"AlternateBase": "{{ colors.surface_container.default.hex | set_lightness: 14 }}",
		"ToolTipBase": "{{ colors.surface_container_high.default.hex | set_lightness: 18 }}",
		"ToolTipText": "{{ colors.on_surface.default.hex | set_lightness: 93 }}",
		"Text": "{{ colors.on_surface.default.hex | set_lightness: 93 }}",
		"Button": "{{ colors.surface_container_high.default.hex | set_lightness: 18 }}",
		"ButtonText": "{{ colors.on_surface.default.hex | set_lightness: 93 }}",
		"BrightText": "{{ colors.on_surface.default.hex | set_lightness: 93 }}",
		"Link": "{{ colors.primary.default.hex }}",
		"Highlight": "{{ colors.primary.default.hex }}",
		"HighlightedText": "{{ colors.on_primary.default.hex }}",
		"fadeColor": "{{ colors.outline_variant.default.hex | set_lightness: 33 }}",
		"fadeAmount": 0.5
	},
	"logColors": {
		"Message": "{{ colors.on_surface.default.hex | set_lightness: 90 }}",
		"Launcher": "{{ colors.primary.default.hex | set_lightness: 75 }}",
		"Debug": "{{ colors.secondary.default.hex | set_lightness: 70 }}",
		"Warning": "{{ colors.primary.default.hex | set_lightness: 55 }}",
		"Error": "{{ colors.error.default.hex }}",
		"Fatal": "{{ colors.error.default.hex }}",
		"MessageHighlight": "{{ colors.on_surface.default.hex | set_lightness: 93 }}",
		"LauncherHighlight": "{{ colors.on_primary.default.hex }}",
		"DebugHighlight": "{{ colors.on_secondary.default.hex }}",
		"WarningHighlight": "{{ colors.on_primary.default.hex }}",
		"ErrorHighlight": "{{ colors.on_error.default.hex }}",
		"FatalHighlight": "{{ colors.on_error.default.hex }}"
	}
}
